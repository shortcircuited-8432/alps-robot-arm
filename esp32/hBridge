
#define Q1 2
#define Q2 4
#define Q3 5
#define Q4 12

void setup() {
  // put your setup code here, to run once:

  Serial.begin(115200);

  pinMode(Q1, OUTPUT);
  pinMode(Q2, OUTPUT);
  pinMode(Q3, OUTPUT);
  pinMode(Q4, OUTPUT);
} 

void loop() {
  // put your main code here, to run repeatedly:

  digitalWrite(Q1, HIGH);
  digitalWrite(Q2, LOW); 
  digitalWrite(Q3, LOW);
  digitalWrite(Q4, HIGH);

  delay(2000);

  digitalWrite(Q1, LOW);
  digitalWrite(Q2, HIGH); 
  digitalWrite(Q3, HIGH);
  digitalWrite(Q4, LOW);

  delay(2000);
}
